---
import Header from '@/components/Header.astro';
import ModeViews from '@/components/ModeViews.astro';
import StatsPanel from '@/components/StatsPanel.astro';
import Toast from '@/components/Toast.astro';
import Layout from '@/layouts/Layout.astro';
---

<Layout>
    <div class="grid h-dvh grid-cols-[minmax(0,1fr)] grid-rows-[auto_minmax(0,1fr)_auto] lg:grid-cols-[minmax(0,1fr)_minmax(20rem,24rem)] lg:grid-rows-[auto_minmax(0,1fr)]">
        <Header />

        <main class="stage relative min-h-0 overflow-hidden">
            <ModeViews />

            <div
                class="search-status"
                data-search-status
                data-state="idle"
                role="status"
                aria-live="polite"
            >
                <span
                    class="search-status-dot"
                    aria-hidden="true"
                ></span>
                <span class="min-w-0" data-search-text></span>
                <button
                    type="button"
                    class="search-status-go"
                    data-search-go
                    hidden
                >
                    Ver
                </button>
                <button
                    type="button"
                    class="search-status-x"
                    data-search-clear
                    aria-label="Cerrar la búsqueda"
                >
                    <svg
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        class="size-3.5"
                    >
                        <path
                            d="M6 6l12 12M18 6 6 18"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                        ></path>
                    </svg>
                </button>
            </div>

            <noscript>
                <p class="p-10 text-dim">
                    π se calcula en tu navegador: hace falta
                    JavaScript.
                </p>
            </noscript>
        </main>

        <StatsPanel />
    </div>
    <Toast />
</Layout>

<script>
    import '@/scripts/app';
</script>
