---
---

<div
    data-toast
    data-visible="false"
    role="status"
    aria-live="polite"
    class="toast"
>
    <span class="toast-dot" aria-hidden="true"></span>
    <div class="min-w-0">
        <p
            class="text-[13px] leading-snug text-fg"
            data-toast-title
        ></p>
        <p
            class="mt-0.5 text-[12px] leading-snug text-mute"
            data-toast-detail
        ></p>
    </div>
</div>
