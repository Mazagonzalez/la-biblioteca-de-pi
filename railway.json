{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "server/Dockerfile",
        "watchPatterns": ["server/**", "src/lib/spigot.ts"]
    },
    "deploy": {
        "healthcheckPath": "/health",
        "restartPolicyType": "ALWAYS"
    }
}
